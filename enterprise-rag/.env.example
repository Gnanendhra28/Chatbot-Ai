# Database Configuration (pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=enterprise_rag

# Multi-LLM Provider API Keys (Groq & Google Gemini)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
LLM_API_KEY=your_generic_api_key_here

# Default Active Model & Provider Settings
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Vector Embeddings Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Local Document Storage
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./data/uploads

# Next.js Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
